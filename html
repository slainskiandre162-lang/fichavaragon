        if(['magicBonus','tempBonus','weight','value','ammoQty'].includes(inp.dataset.w)) v = parseFloat(v||0);
        if(inp.dataset.w==='proficient') v = v==='1';
        if(inp.dataset.w==='needsAmmo') v = v==='1';
        w[inp.dataset.w] = v;
        markDirty();
        if(inp.dataset.w==='name'||inp.dataset.w==='category') div.querySelector('.iname').textContent = w.name||'Nova Arma';
        if(inp.dataset.w==='slot'){
          if(w.equipped && (w.slot==='Principal' || w.slot==='Secundária')){
            CURRENT.weapons.forEach(other=>{ if(other.id!==w.id && other.slot===w.slot) other.equipped=false; });
          }
          render();
        }
      });
    });
    div.querySelector('[data-act="toggleEquip"]').addEventListener('click', ()=>{
      if(!w.equipped){
        // Principal e Secundária são únicos; Reserva permite múltiplas armas simultâneas
        if(w.slot==='Principal' || w.slot==='Secundária'){
          CURRENT.weapons.forEach(other=>{ if(other.id!==w.id && other.slot===w.slot) other.equipped=false; });
        }
        w.equipped = true;
        Hist.add(CURRENT,'Arma equipada', `${w.name} (${w.slot})`, '');
