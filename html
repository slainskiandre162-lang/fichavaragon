    document.getElementById('resourcePanel').innerHTML = html;
    bindResourceBarEvents();
  }

  function bindResourceBarEvents(){
    const c = CURRENT;
    const panel = document.getElementById('resourcePanel');

    // A barra de "Vida da Armadura" só é editável diretamente quando há exatamente 1 peça equipada;
    // com 0 ou várias peças, o jogador ajusta cada uma na aba Armaduras (evita ambiguidade de qual peça alterar).
    function singleArmor(){ const eq = Calc.equippedArmors(c); return eq.length===1 ? eq[0] : null; }

    function pulse(trackSelector, up){
      const track = panel.querySelector(trackSelector);
      const fill = track && track.querySelector('.bar-fill');
      if(!fill) return;
      fill.classList.remove('pulse-up','pulse-down');
      void fill.offsetWidth;
      fill.classList.add(up?'pulse-up':'pulse-down');
    }

    function currentValue(id){
      const arm = singleArmor();
      if(id==='hp') return c.hp.current;
      if(id==='temp') return c.hp.temp;
      if(id==='armor') return arm?arm.hpCurrent:0;
      if(id==='hitdice') return c.hitDice.current;
      return 0;
    }
    function maxValue(id){
      const arm = singleArmor();
      if(id==='hp') return c.hp.max;
      if(id==='temp') return Math.max(c.hp.temp,1);
      if(id==='armor') return arm?arm.hpMax:1;
      if(id==='hitdice') return c.hitDice.max;
      return 1;
    }
    function setResource(id, newVal){
      const arm = singleArmor();
      const before = currentValue(id);
      if(id==='hp'){ c.hp.current = Math.max(0, Math.min(c.hp.max, newVal)); }
      else if(id==='temp'){ c.hp.temp = Math.max(0, newVal); }
      else if(id==='armor'){ if(!arm) return; arm.hpCurrent = Math.max(0, Math.min(arm.hpMax, newVal)); }
      else if(id==='hitdice'){ c.hitDice.current = Math.max(0, Math.min(c.hitDice.max, newVal)); }
      pulse(`[data-bartrack="${id}"]`, currentValue(id)>before);
      markDirty(); render();
    }

    panel.querySelectorAll('[data-barstep]').forEach(btn=>{
      btn.addEventListener('click', (e)=>{
        e.stopPropagation();
        const id = btn.dataset.barstep;
        const dir = parseInt(btn.dataset.dir);
        setResource(id, currentValue(id)+dir);
      });
    });

    panel.querySelectorAll('[data-bartrack]').forEach(track=>{
      const id = track.dataset.bartrack;
      track.addEventListener('click', (e)=>{
        if(id==='reaction'){
          c.reaction.used = !c.reaction.used;
          if(!c.reaction.used){ c.reaction.esquivaBonusActive=false; c.reaction.protecaoRdActive=false; }
          markDirty(); render();
          return;
        }
        const rect = track.getBoundingClientRect();
        const pct = Math.max(0, Math.min(1, (e.clientX-rect.left)/rect.width));
        setResource(id, Math.round(pct*maxValue(id)));
      });
    });
  }

