  const SPELL_LEVEL_LABELS = {0:'Truques',1:'Magia Nível 1',2:'Magia Nível 2',3:'Magia Nível 3',4:'Magia Nível 4',5:'Magia Nível 5',6:'Magia Nível 6',7:'Magia Nível 7',8:'Magia Nível 8',9:'Magia Nível 9'};

  function renderResourcePanel(){
    const c = CURRENT;
