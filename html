<script>
/* =========================================================
   VARAGON — ARQUITETURA EM MÓDULOS (namespaces)
   Store  -> persistência (localStorage), múltiplos personagens
   Model  -> criação de personagem padrão + listas de referência
   Calc   -> todos os cálculos automáticos e regras de Varagon
   Dice   -> parser e execução de expressões de dados
   Hist   -> histórico de combate/ações
   UI     -> renderização das abas e da interface
   PDF    -> montagem da folha para impressão/exportação em PDF
   App    -> inicialização
   ========================================================= */

/* ---------------------- STORE ---------------------- */
const Store = (() => {
  const LIST_KEY = 'varagon_char_list';
  const ACTIVE_KEY = 'varagon_active_id';
  const CHAR_PREFIX = 'varagon_char_';

  function listIds(){
    try{ return JSON.parse(localStorage.getItem(LIST_KEY)) || []; }catch(e){ return []; }
  }
  function saveList(ids){ localStorage.setItem(LIST_KEY, JSON.stringify(ids)); }
  function getActiveId(){ return localStorage.getItem(ACTIVE_KEY); }
  function setActiveId(id){ localStorage.setItem(ACTIVE_KEY, id); }
  function load(id){
    try{
      const c = JSON.parse(localStorage.getItem(CHAR_PREFIX+id));
      return c ? Model.normalize(c) : null;
    }catch(e){ return null; }
  }
  function save(char){
    localStorage.setItem(CHAR_PREFIX+char.id, JSON.stringify(char));
    let ids = listIds();
    if(!ids.includes(char.id)){ ids.push(char.id); saveList(ids); }
  }
  function remove(id){
    localStorage.removeItem(CHAR_PREFIX+id);
    saveList(listIds().filter(x=>x!==id));
  }
  function allCharsSummary(){
    return listIds().map(id=>{
      const c = load(id);
      return c ? {id:c.id, name:c.meta.name||'Sem nome', level:c.meta.level||1, cls:c.meta.classe||''} : null;
    }).filter(Boolean);
  }
  return {listIds, getActiveId, setActiveId, load, save, remove, allCharsSummary};
})();

/* ---------------------- MODEL ---------------------- */
const Model = (() => {
  const SKILLS = [
    ['Acrobacia','des'],['Arcanismo','int'],['Atletismo','for'],['Atuação','car'],
    ['Enganação','car'],['Furtividade','des'],['História','int'],['Intimidação','car'],
    ['Intuição','sab'],['Investigação','int'],['Lidar com Animais','sab'],['Medicina','sab'],
    ['Natureza','int'],['Percepção','sab'],['Persuasão','car'],['Prestidigitação','des'],
    ['Religião','int'],['Sobrevivência','sab']
  ];
  const DEFAULT_CONDITIONS = ['Cego','Enfeitiçado','Ensurdecido','Exausto','Amedrontado','Agarrado','Incapacitado','Invisível','Paralisado','Petrificado','Envenenado','Caído','Contido','Atordoado','Inconsciente'];
  const DEFAULT_DAMAGE_TYPES = ['Ácido','Contundente','Cortante','Perfurante','Fogo','Frio','Elétrico','Trovão','Veneno','Necrótico','Radiante','Psíquico','Força'];

  function uid(prefix='id'){ return prefix+'_'+Math.random().toString(36).slice(2,10)+Date.now().toString(36); }

  function newAttr(base=10){ return {base, temp:0, perm:0}; }

  function blankCharacter(name='Novo Aventureiro'){
    const skills = {};
    SKILLS.forEach(([n,attr])=>{ skills[n] = {attr, prof:'none', temp:0, perm:0}; });
    const saves = {};
    ['for','des','con','int','sab','car'].forEach(a=>{ saves[a] = {proficient:false, temp:0, perm:0}; });
    const dmgTypes = {};
    DEFAULT_DAMAGE_TYPES.forEach(t=>{ dmgTypes[t] = 'normal'; });

    return {
      id: uid('char'),
      meta:{
        name, title:'', classe:'', subclasse:'', raca:'', level:1, xp:0, tendencia:'',
        origem:'', reino:'', idade:'', sexo:'', altura:'', peso:'', idiomas:'', divindade:'',
        jogador:'', mestre:'', campanha:'', personalidade:'', ideais:'', vinculos:'', defeitos:'',
        historia:'', observacoes:'', portrait:''
      },
      attributes:{ for:newAttr(), des:newAttr(), con:newAttr(), int:newAttr(), sab:newAttr(), car:newAttr() },
      proficiency:{ auto:true, manual:2 },
      hp:{ max:10, current:10, temp:0, permWounds:0 },
      hitDice:{ max:1, current:1, die:'d8' },
      reaction:{ used:false, esquivaBonusActive:false, protecaoRdActive:false },
      esquivaOther:0,
      armors:[],
      weapons:[],
      equipment:{ capacete:'', peitoral:'', ombreiras:'', bracadeiras:'', luvas:'', cinto:'', calcas:'', botas:'', anel1:'', anel2:'', amuleto:'', colar:'', manto:'', escudo:'', armaPrincipal:'', armaSecundaria:'', armaReserva:'', itemEspecial:'' },
      inventory:[],
      weightConfig:{ multiplier:15 },
      currency:{ cp:0, sp:0, ep:0, gp:0, pp:0, custom:[] },
      skills, saves,
      conditions:[],
      damageTypes:dmgTypes,
      spells:{ list:[], slots:{0:{max:0,used:0},1:{max:0,used:0},2:{max:0,used:0},3:{max:0,used:0},4:{max:0,used:0},5:{max:0,used:0},6:{max:0,used:0},7:{max:0,used:0},8:{max:0,used:0},9:{max:0,used:0}}, concentratingOn:null },
      classResources:[],
      raceFeatures:[],
      classFeatures:[],
      companions:[],
      mounts:[],
      notes:'',
      history:[],
      settings:{ theme:'dark', critRule:'double_dice', fumbleRule:'none', dmgOrder:'default', resistRounding:'down', animations:true, sounds:false, autoRoll:true, scale:100, spellsCollapsed:false }
    };
  }
  function normalize(c){
    if(!c) return c;
    const blank = blankCharacter((c.meta && c.meta.name) || 'Aventureiro');
    Object.keys(blank).forEach(k=>{ if(c[k]===undefined) c[k] = blank[k]; });
    ['armors','weapons','inventory','conditions','classResources','raceFeatures','classFeatures','companions','mounts','history'].forEach(k=>{
      if(!Array.isArray(c[k])) c[k] = [];
    });
    if(!c.spells) c.spells = blank.spells;
    if(!c.spells.slots) c.spells.slots = blank.spells.slots;
    if(!Array.isArray(c.spells.list)) c.spells.list = [];
    if(!c.currency) c.currency = blank.currency;
    if(!Array.isArray(c.currency.custom)) c.currency.custom = [];
    if(!c.damageTypes) c.damageTypes = blank.damageTypes;
    if(!c.equipment) c.equipment = blank.equipment;
    if(!c.settings) c.settings = blank.settings;
    if(!c.weightConfig) c.weightConfig = blank.weightConfig;
    if(!c.hitDice) c.hitDice = blank.hitDice;
    if(!c.reaction) c.reaction = blank.reaction;
    // Compatibilidade com fichas antigas: garante slot/equipped/recolhido em cada peça de armadura e arma
    c.armors.forEach(a=>{ if(a.slot===undefined) a.slot='Principal'; if(a.equipped===undefined) a.equipped=false; if(a.collapsed===undefined) a.collapsed=false; });
    c.weapons.forEach(w=>{ if(w.slot===undefined) w.slot='Nenhum'; if(w.equipped===undefined) w.equipped=false; if(w.collapsed===undefined) w.collapsed=false; });
    if(c.spells && Array.isArray(c.spells.list)) c.spells.list.forEach(sp=>{ if(sp.collapsed===undefined) sp.collapsed=false; });
    if(c.settings && c.settings.spellsCollapsed===undefined) c.settings.spellsCollapsed=false;
    return c;
  }
  return {SKILLS, DEFAULT_CONDITIONS, DEFAULT_DAMAGE_TYPES, uid, newAttr, blankCharacter, normalize};
})();

/* ---------------------- CALC ---------------------- */
const Calc = (() => {
  function total(attr){ return attr.base + attr.temp + attr.perm; }
  function mod(attr){ return Math.floor((total(attr)-10)/2); }
  function fmt(n){ return (n>=0?'+':'')+n; }

  function profBonus(char){
    if(!char.proficiency.auto) return char.proficiency.manual;
    const lvl = char.meta.level||1;
    if(lvl>=17) return 6;
    if(lvl>=13) return 5;
    if(lvl>=9) return 4;
    if(lvl>=5) return 3;
    return 2;
  }

  // Retorna todas as peças de armadura atualmente equipadas (múltiplas ao mesmo tempo são permitidas)
  function equippedArmors(char){ return char.armors.filter(a=>a.equipped); }
  // Retrocompatibilidade: retorna a peça "Principal" equipada, ou a primeira equipada, ou null
  function equippedArmor(char){
    const eq = equippedArmors(char);
    return eq.find(a=>a.slot==='Principal') || eq[0] || null;
  }

  function armorStateInfo(armor){
    if(!armor || armor.hpMax<=0) return {pct:100, label:'Inteira', key:'inteira', broken:false};
    const pct = Math.max(0, Math.min(100, Math.round((armor.hpCurrent/armor.hpMax)*100)));
    let label='Inteira', key='inteira';
    if(pct<=0){ label='Quebrada'; key='quebrada'; }
    else if(pct<25){ label='Muito Danificada'; key='muito'; }
    else if(pct<50){ label='Danificada'; key='danificada'; }
    else if(pct<75){ label='Pouco Danificada'; key='pouco'; }
    else { label='Inteira'; key='inteira'; }
    return {pct, label, key, broken: pct<=0};
  }

  // Soma o Bônus de Esquiva e a Redução de Dano de TODAS as peças equipadas e não quebradas
  function armorContribution(char){
    let dodge=0, rd=0;
    equippedArmors(char).forEach(a=>{
      const st = armorStateInfo(a);
      if(!st.broken){ dodge += (a.dodgeBonus||0); rd += (a.rd||0); }
    });
    return {dodge, rd};
  }

  // Soma a Vida (atual/máxima) de todas as peças equipadas — usado nas barras de recurso e na barra superior
  function armorHpTotals(char){
    let max=0, cur=0;
    equippedArmors(char).forEach(a=>{ max += (a.hpMax||0); cur += (a.hpCurrent||0); });
    return {max, cur};
  }

  function esquiva(char){
    const pb = profBonus(char);
    const desMod = mod(char.attributes.des);
    const arm = armorContribution(char);
    const reactionBonus = char.reaction.esquivaBonusActive ? 2 : 0;
    const value = 8 + pb + desMod + arm.dodge + (char.esquivaOther||0) + reactionBonus;
    return {value, pb, desMod, armorDodge:arm.dodge, other:(char.esquivaOther||0), reactionBonus};
  }

  function skillMod(char, name){
    const s = char.skills[name];
    const attrMod = mod(char.attributes[s.attr]);
    const pb = profBonus(char);
    let profPart = 0;
    if(s.prof==='half') profPart = Math.floor(pb/2);
    else if(s.prof==='prof') profPart = pb;
    else if(s.prof==='expertise') profPart = pb*2;
    return attrMod + profPart + (s.temp||0) + (s.perm||0);
  }

  function saveMod(char, attrKey){
    const s = char.saves[attrKey];
    const attrMod = mod(char.attributes[attrKey]);
    const pb = profBonus(char);
    return attrMod + (s.proficient?pb:0) + (s.temp||0) + (s.perm||0);
  }

  function weaponAttrMod(char, weapon){
    if(weapon.modAttr==='custom') return weapon.customMod||0;
    return mod(char.attributes[weapon.modAttr||'for']);
  }

  function weaponAttackBonus(char, weapon){
    const pb = weapon.proficient===false ? 0 : profBonus(char);
    return weaponAttrMod(char,weapon) + pb + (weapon.magicBonus||0) + (weapon.tempBonus||0);
  }

  function carryWeight(char){
    let w = 0;
    char.inventory.forEach(i=>{ w += (i.weight||0)*(i.qty||1); });
    char.armors.forEach(a=>{ w += (a.weight||0); });
    char.weapons.forEach(wp=>{ w += (wp.weight||0); });
    return w;
  }
  function carryThresholds(char){
    const forScore = total(char.attributes.for);
    const m = char.weightConfig.multiplier||15;
    return { light: forScore*(m/3), medium: forScore*(m*2/3), heavy: forScore*m };
  }

  function currencyTotalGold(char){
    const c = char.currency;
    let g = (c.cp||0)*0.01 + (c.sp||0)*0.1 + (c.ep||0)*0.5 + (c.gp||0)*1 + (c.pp||0)*10;
    (c.custom||[]).forEach(cu=>{ g += (cu.qty||0)*(cu.rateToGold||0); });
    return Math.round(g*100)/100;
  }

  /* Ordem obrigatória de dano (Varagon): bruto -> RD -> min 1 -> resistência -> vulnerabilidade -> imunidade -> armadura(s) -> personagem */
  function applyDamagePipeline(char, rawDamage, damageTypeKey, isCrit){
    const steps = [];
    let dmg = rawDamage;
    steps.push({label:'Dano bruto', value:dmg});

    const contrib = armorContribution(char); // soma de todas as peças equipadas e não quebradas
    const rd = contrib.rd;
    const beforeRd = dmg;
    dmg = Math.max(0, dmg - rd);
    if(dmg<=0 && char.damageTypes[damageTypeKey]!=='imunidade'){ dmg = 1; }
    steps.push({label:`Redução de Dano (RD ${rd})`, value:dmg, note: beforeRd-rd<=0 ? 'Dano mínimo de 1 aplicado' : ''});

    const state = char.damageTypes[damageTypeKey] || 'normal';
    if(state==='resistencia'){
      dmg = Math.floor(dmg/2);
      steps.push({label:'Resistência aplicada (½)', value:dmg});
    } else {
      steps.push({label:'Resistência', value:dmg, note:'não aplicável'});
    }
    if(state==='vulnerabilidade'){
      dmg = dmg*2;
      steps.push({label:'Vulnerabilidade aplicada (x2)', value:dmg});
    } else {
      steps.push({label:'Vulnerabilidade', value:dmg, note:'não aplicável'});
    }
    if(state==='imunidade'){
      dmg = 0;
      steps.push({label:'Imunidade — dano zerado', value:dmg});
    } else {
      steps.push({label:'Imunidade', value:dmg, note:'não aplicável'});
    }

    // Distribui o dano restante entre TODAS as peças de armadura equipadas (a Principal absorve primeiro,
    // depois escudo/elmo/braceletes/outros, na ordem em que estão equipados) até se esgotarem
    const eqArmors = equippedArmors(char).filter(a=>!armorStateInfo(a).broken)
      .sort((a,b)=> (a.slot==='Principal'?-1:0) - (b.slot==='Principal'?-1:0));
    let remaining = dmg;
    let armorAbsorbed = 0;
    if(dmg>0){
      eqArmors.forEach(a=>{
        if(remaining<=0) return;
        const absorb = Math.min(a.hpCurrent, remaining);
        if(absorb>0){
          a.hpCurrent = Math.max(0, a.hpCurrent - absorb);
          remaining -= absorb;
          armorAbsorbed += absorb;
          steps.push({label:`Vida da Armadura (${a.name}) absorveu`, value:absorb});
          if(a.hpCurrent<=0){ steps.push({label:`${a.name} quebrou`, value:0}); }
        }
      });
    }
    const hpDamage = Math.max(0, remaining);
    if(eqArmors.length===0 && dmg>0){ steps.push({label:'Nenhuma armadura equipada para absorver', value:dmg}); }
    char.hp.current = Math.max(0, char.hp.current - hpDamage);
    steps.push({label:'Dano final ao personagem', value:hpDamage});

    return {finalDamage:dmg, armorAbsorbed, hpDamage, steps, armors:eqArmors};
  }

  return {total, mod, fmt, profBonus, equippedArmor, equippedArmors, armorHpTotals, armorStateInfo, armorContribution, esquiva,
    skillMod, saveMod, weaponAttrMod, weaponAttackBonus, carryWeight, carryThresholds,
    currencyTotalGold, applyDamagePipeline};
})();

/* ---------------------- DICE ---------------------- */
const Dice = (() => {
  function rollDie(sides){ return 1+Math.floor(Math.random()*sides); }

  // Parses terms like: 2d20kh1, 3d6, 4d8+5, 8d6+4, d20, 10, -3
  function parseAndRoll(expr){
    expr = expr.trim().replace(/\s+/g,'');
    if(!expr) return null;
    const tokens = expr.match(/[+-]?[^+-]+/g);
    if(!tokens) return null;
    let total = 0;
    const parts = [];
    for(const tok of tokens){
      const sign = tok.startsWith('-') ? -1 : 1;
      const clean = tok.replace(/^[+-]/,'');
      const diceMatch = clean.match(/^(\d*)d(\d+)(k[hl]\d+)?$/i);
      if(diceMatch){
        const count = diceMatch[1] ? parseInt(diceMatch[1]) : 1;
        const sides = parseInt(diceMatch[2]);
        const keep = diceMatch[3];
        let rolls = [];
        for(let i=0;i<count;i++) rolls.push(rollDie(sides));
        let kept = rolls.slice();
        let keepLabel = '';
        if(keep){
          const kh = /kh(\d+)/i.exec(keep);
          const kl = /kl(\d+)/i.exec(keep);
          const sorted = rolls.slice().sort((a,b)=>b-a);
          if(kh){ kept = sorted.slice(0, parseInt(kh[1])); keepLabel = ` (mantendo ${kh[1]} maior(es))`; }
          if(kl){ kept = sorted.slice().sort((a,b)=>a-b).slice(0, parseInt(kl[1])); keepLabel = ` (mantendo ${kl[1]} menor(es))`; }
        }
        const sum = kept.reduce((a,b)=>a+b,0)*sign;
        total += sum;
        parts.push(`${sign<0?'-':'+'}[${rolls.join(', ')}]${keepLabel}d${sides}=${sign<0?-sum:sum}`);
      } else if(/^\d+$/.test(clean)){
        const n = parseInt(clean)*sign;
        total += n;
        parts.push(`${sign<0?'-':'+'}${clean}`);
      }
    }
    return {total, detail: parts.join(' '), expr};
  }

  return {rollDie, parseAndRoll};
})();

/* ---------------------- HISTORY ---------------------- */
const Hist = (() => {
  function add(char, type, resultText, detail){
    const entry = { time: new Date().toLocaleString('pt-BR'), type, result: resultText, detail: detail||'' };
    char.history.unshift(entry);
    if(char.history.length>500) char.history.length = 500;
    return entry;
  }
  return {add};
})();

