    calcCard.className = 'card';
    calcCard.style.marginTop='16px';
    calcCard.innerHTML = `
      <h3>Calculadora de Dano (Ordem Varagon)</h3>
      <div class="row">
        <div class="field"><label>Dano Bruto</label><input type="number" id="calcDmgValue" value="10"></div>
        <div class="field"><label>Tipo de Dano</label><select id="calcDmgType">${dmgTypeOptions}</select></div>
        <div class="field"><label>Crítico?</label><select id="calcDmgCrit"><option value="0">Não</option><option value="1">Sim</option></select></div>
        <div class="field"><label>Fonte</label><input type="text" id="calcDmgSource" placeholder="ex: Goblin"></div>
      </div>
      <button class="btn" id="btnApplyDamage">Aplicar Dano</button>
      <div id="calcResultBox" style="margin-top:12px;"></div>
    `;
    el.appendChild(calcCard);

    setTimeout(()=>{
      document.getElementById('esquivaOther').addEventListener('input', e=>{ c.esquivaOther = parseInt(e.target.value||0); markDirty(); render(); });
      document.getElementById('hpMax').addEventListener('input', e=>{ c.hp.max = parseInt(e.target.value||0); markDirty(); renderTopbar(); renderResourcePanel(); });
      document.getElementById('hpCurrent').addEventListener('input', e=>{ c.hp.current = parseInt(e.target.value||0); markDirty(); renderTopbar(); renderResourcePanel(); });
      document.getElementById('hpTemp').addEventListener('input', e=>{ c.hp.temp = parseInt(e.target.value||0); markDirty(); renderResourcePanel(); });
      document.getElementById('hpPerm').addEventListener('input', e=>{ c.hp.permWounds = parseInt(e.target.value||0); markDirty(); });
      document.getElementById('hdMax').addEventListener('input', e=>{ c.hitDice.max = parseInt(e.target.value||0); markDirty(); renderResourcePanel(); });
      document.getElementById('hdCurrent').addEventListener('input', e=>{ c.hitDice.current = parseInt(e.target.value||0); markDirty(); renderResourcePanel(); });
      document.getElementById('hdDie').addEventListener('input', e=>{ c.hitDice.die = e.target.value; markDirty(); });

      document.getElementById('btnHeal').addEventListener('click', ()=>{
        const r = Dice.parseAndRoll('1d8');
        c.hp.current = Math.min(c.hp.max, c.hp.current + r.total);
        toast('Cura', '+'+r.total, 'Vida atual: '+c.hp.current);
        Hist.add(c,'Cura', `+${r.total} de vida`, `Vida atual: ${c.hp.current}/${c.hp.max}`);
        markDirty(); render();
      });
      document.getElementById('btnDamageQuick').addEventListener('click', ()=>{
        const v = prompt('Dano bruto a aplicar diretamente à Vida (sem pipeline):', '5');
        if(v===null) return;
        const n = parseInt(v)||0;
        c.hp.current = Math.max(0, c.hp.current-n);
        Hist.add(c,'Dano direto', `-${n} de vida`, `Vida atual: ${c.hp.current}/${c.hp.max}`);
        markDirty(); render();
      });
      document.getElementById('btnSpendHd').addEventListener('click', ()=>{
        if(c.hitDice.current<=0){ toast('Dados de Vida','0','Nenhum dado disponível'); return; }
        const sides = parseInt((c.hitDice.die.match(/\d+/)||['8'])[0]);
        const r = Dice.parseAndRoll(`1d${sides}`);
        const conMod = Calc.mod(c.attributes.con);
        const healed = Math.max(0, r.total+conMod);
        c.hitDice.current -= 1;
        c.hp.current = Math.min(c.hp.max, c.hp.current+healed);
        Hist.add(c,'Dado de Vida gasto', `Curou ${healed}`, `d${sides}=${r.total} + CON(${Calc.fmt(conMod)})`);
        toast('Dado de Vida', '+'+healed, `d${sides}(${r.total}) + CON`);
        markDirty(); render();
      });
      document.getElementById('btnReactEsquiva').addEventListener('click', ()=>{
        c.reaction.used = true; c.reaction.esquivaBonusActive = true;
        Hist.add(c,'Reação','Esquiva usada','+2 Esquiva contra próximo ataque');
        markDirty(); render();
      });
      document.getElementById('btnReactProtecao').addEventListener('click', ()=>{
        c.reaction.used = true; c.reaction.protecaoRdActive = true;
        Hist.add(c,'Reação','Proteção usada','+5 RD contra próximo ataque');
        markDirty(); render();
      });
      document.getElementById('btnReactContra').addEventListener('click', ()=>{
        Hist.add(c,'Reação','Contra-ataque usado','Ataque corpo a corpo imediato concedido');
        toast('Contra-ataque','!','Realize um ataque corpo a corpo imediato');
        markDirty();
      });
      document.getElementById('btnReactReset').addEventListener('click', ()=>{
        c.reaction.used=false; c.reaction.esquivaBonusActive=false; c.reaction.protecaoRdActive=false;
        markDirty(); render();
      });

      document.getElementById('btnApplyDamage').addEventListener('click', ()=>{
        const raw = parseInt(document.getElementById('calcDmgValue').value||0);
        const type = document.getElementById('calcDmgType').value;
        const crit = document.getElementById('calcDmgCrit').value==='1';
        const source = document.getElementById('calcDmgSource').value||'—';
        let finalRaw = raw;
        if(crit) finalRaw = raw*2;
        const res = Calc.applyDamagePipeline(c, finalRaw, type, crit);
        const box = document.getElementById('calcResultBox');
        box.innerHTML = `<div class="card" style="background:var(--void-2);">
          <div class="muted" style="margin-bottom:6px;">Fonte: ${source} ${crit?'· <b style="color:var(--blood-bright)">CRÍTICO</b>':''}</div>
          ${res.steps.map(s=>`<div style="display:flex;justify-content:space-between;font-family:var(--font-mono);font-size:.85rem;padding:2px 0;border-bottom:1px dashed var(--leather-edge);"><span>${s.label}${s.note?` <span class="muted">(${s.note})</span>`:''}</span><span>${s.value}</span></div>`).join('')}
        </div>`;
        Hist.add(c,'Dano recebido', `${source}: ${res.hpDamage} à vida, ${res.armorAbsorbed} à armadura`, res.steps.map(s=>`${s.label}=${s.value}`).join(' | '));
        markDirty(); renderTopbar(); renderResourcePanel();
      });
    },0);

    return el;
  }

