<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Varagon — Ficha do Aventureiro</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700;900&family=Cinzel:wght@400;500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
/* =========================================================
   VARAGON — DESIGN TOKENS
   ========================================================= */
:root{
  --void:#151009;
  --void-2:#1b140c;
  --leather:#2c2015;
  --leather-2:#38291a;
  --leather-edge:#4a3620;
  --parchment:#ecdfba;
  --parchment-2:#e2d2a5;
  --parchment-dim:#cdbb8d;
  --ink:#2a1d10;
  --ink-soft:#4a3a24;
  --gold:#c8992e;
  --gold-bright:#f0c05a;
  --gold-dim:#8a6a2a;
  --steel:#8993a1;
  --steel-dim:#5c6470;
  --blood:#9a2f2a;
  --blood-bright:#d1483f;
  --forest:#4f6b45;
  --forest-bright:#79a267;
  --arcane:#5b6fa8;
  --shadow:rgba(0,0,0,.55);
  --radius:10px;
  --radius-sm:6px;
  --font-display:'Cinzel', serif;
  --font-deco:'Cinzel Decorative', serif;
  --font-body:'EB Garamond', serif;
  --font-mono:'JetBrains Mono', monospace;
}

*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  background:
    radial-gradient(ellipse at top left, rgba(200,153,46,.06), transparent 60%),
    radial-gradient(ellipse at bottom right, rgba(90,60,20,.10), transparent 55%),
    var(--void);
  color:var(--parchment);
  font-family:var(--font-body);
  font-size:16px;
  min-height:100vh;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
h1,h2,h3,h4,.display{font-family:var(--font-display); letter-spacing:.03em;}
::-webkit-scrollbar{width:10px;height:10px;}
::-webkit-scrollbar-track{background:var(--void-2);}
::-webkit-scrollbar-thumb{background:var(--leather-edge); border-radius:6px;}
a{color:var(--gold-bright);}
button{font-family:var(--font-body); cursor:pointer;}
input,select,textarea{font-family:var(--font-body); color:var(--ink); background:var(--parchment); border:1px solid var(--leather-edge); border-radius:var(--radius-sm); padding:6px 8px; font-size:15px;}
input:focus,select:focus,textarea:focus{outline:2px solid var(--gold-bright); outline-offset:1px;}
textarea{resize:vertical; font-family:var(--font-body);}
label{display:block; font-size:.78rem; text-transform:uppercase; letter-spacing:.06em; color:var(--parchment-dim); margin-bottom:3px;}
.field{margin-bottom:10px;}
.row{display:flex; gap:10px; flex-wrap:wrap;}
.row>.field{flex:1; min-width:120px;}
.grid{display:grid; gap:12px;}
.card{
  background:linear-gradient(160deg, var(--leather-2), var(--leather));
  border:1px solid var(--leather-edge);
  border-radius:var(--radius);
  box-shadow:0 4px 14px var(--shadow), inset 0 1px 0 rgba(255,255,255,.03);
  padding:16px;
}
.card h3{margin:0 0 10px; font-size:1.05rem; color:var(--gold-bright); display:flex; align-items:center; gap:8px;}
.btn{
  background:linear-gradient(180deg, var(--gold-bright), var(--gold));
  color:var(--ink); border:1px solid var(--gold-dim); border-radius:var(--radius-sm);
  padding:8px 14px; font-weight:600; letter-spacing:.02em; box-shadow:0 2px 0 var(--gold-dim);
  transition:transform .08s ease;
}
.btn:active{transform:translateY(1px); box-shadow:0 1px 0 var(--gold-dim);}
.btn.secondary{background:linear-gradient(180deg,#4a5462,#333c47); color:var(--parchment); border-color:#20262d; box-shadow:0 2px 0 #20262d;}
.btn.danger{background:linear-gradient(180deg, var(--blood-bright), var(--blood)); color:#fff0ee; border-color:#5e1a17; box-shadow:0 2px 0 #5e1a17;}
.btn.ghost{background:transparent; border:1px solid var(--leather-edge); color:var(--parchment-dim); box-shadow:none;}
.btn.small{padding:4px 9px; font-size:.82rem;}
.pill{display:inline-flex; align-items:center; gap:4px; background:var(--void-2); border:1px solid var(--leather-edge); border-radius:999px; padding:3px 10px; font-size:.78rem; color:var(--parchment-dim);}
.hidden{display:none !important;}
.muted{color:var(--parchment-dim);}
.icon{width:1em; height:1em; display:inline-block; vertical-align:-.15em;}

/* ============ APP SHELL ============ */
#app{display:flex; min-height:100vh;}

/* --- Sidebar (desktop) --- */
#sidebar{
  width:230px; flex-shrink:0;
  background:linear-gradient(180deg, var(--leather-2), var(--void-2) 90%);
  border-right:2px solid var(--leather-edge);
  display:flex; flex-direction:column;
  position:sticky; top:0; height:100vh; z-index:40;
}
#sidebar .brand{
  padding:18px 16px 14px; text-align:center;
  border-bottom:1px solid var(--leather-edge);
  background:radial-gradient(ellipse at top, rgba(200,153,46,.12), transparent 70%);
}
#sidebar .brand .title{font-family:var(--font-deco); font-size:1.5rem; color:var(--gold-bright); text-shadow:0 2px 6px rgba(0,0,0,.6);}
#sidebar .brand .sub{font-size:.7rem; letter-spacing:.2em; color:var(--parchment-dim); text-transform:uppercase; margin-top:2px;}
#tabnav{list-style:none; margin:0; padding:8px; overflow-y:auto; flex:1;}
#tabnav li{margin-bottom:2px;}
#tabnav button{
  width:100%; text-align:left; background:transparent; border:1px solid transparent; color:var(--parchment-dim);
  padding:9px 12px; border-radius:var(--radius-sm); font-size:.92rem; display:flex; align-items:center; gap:10px;
  transition:background .12s, color .12s;
}
#tabnav button .ic{font-size:1.05rem; width:1.3em; text-align:center;}
#tabnav button:hover{background:rgba(200,153,46,.08); color:var(--parchment);}
#tabnav button.active{background:linear-gradient(90deg, rgba(200,153,46,.22), rgba(200,153,46,.04)); color:var(--gold-bright); border-color:var(--gold-dim); font-weight:600;}
#sidebar .foot{padding:10px; border-top:1px solid var(--leather-edge); font-size:.72rem; color:var(--parchment-dim); text-align:center;}

/* --- Main column --- */
#main{flex:1; min-width:0; display:flex; flex-direction:column;}

/* --- Top bar --- */
#topbar{
  position:sticky; top:0; z-index:30;
  background:linear-gradient(180deg, var(--leather-2), var(--leather));
  border-bottom:2px solid var(--leather-edge);
  padding:10px 16px; display:flex; align-items:center; gap:16px; flex-wrap:wrap;
  box-shadow:0 4px 12px var(--shadow);
}
#topbar .portrait{
  width:46px; height:46px; border-radius:50%; border:2px solid var(--gold); background:var(--void-2) center/cover no-repeat;
  display:flex; align-items:center; justify-content:center; font-size:1.3rem; color:var(--gold-dim); flex-shrink:0;
}
#topbar .idblock{min-width:0;}
#topbar .idblock .nm{font-family:var(--font-display); font-size:1.05rem; color:var(--gold-bright); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:38vw;}
#topbar .idblock .meta{font-size:.76rem; color:var(--parchment-dim);}
#topbar .vitals{display:flex; gap:14px; flex-wrap:wrap; margin-left:auto; align-items:center;}
#topbar .vit{font-family:var(--font-mono); font-size:.82rem; text-align:center; min-width:56px;}
#topbar .vit .lbl{display:block; font-family:var(--font-body); font-size:.62rem; color:var(--parchment-dim); text-transform:uppercase; letter-spacing:.08em;}
#topbar .vit .val{font-size:1rem; color:var(--parchment);}
#topbar .icons{display:flex; gap:6px;}
#topbar .icons button{background:var(--void-2); border:1px solid var(--leather-edge); color:var(--parchment-dim); border-radius:var(--radius-sm); width:34px; height:34px; font-size:1rem;}
#topbar .icons button:hover{color:var(--gold-bright); border-color:var(--gold-dim);}
#saveIndicator{font-size:.7rem; color:var(--forest-bright); display:flex; align-items:center; gap:5px; white-space:nowrap;}
#saveIndicator .dot{width:7px; height:7px; border-radius:50%; background:var(--forest-bright); box-shadow:0 0 6px var(--forest-bright);}
#saveIndicator.saving .dot{background:var(--gold-bright); box-shadow:0 0 6px var(--gold-bright);}

/* --- Resource bars panel --- */
#resourcePanel{padding:12px 16px; display:flex; flex-wrap:wrap; align-items:flex-start; gap:12px; background:var(--void-2); border-bottom:1px solid var(--leather-edge);}
.bar-wrap{
  position:relative; isolation:isolate; z-index:1;
  font-size:.72rem; flex:1 1 168px; min-width:150px; max-width:260px; min-height:52px;
  background:linear-gradient(160deg, var(--leather-2), var(--leather));
  border:1px solid var(--leather-edge); border-radius:var(--radius-sm);
  padding:7px 9px; box-shadow:0 2px 6px rgba(0,0,0,.35);
}
.bar-wrap.pip-wrap{flex-basis:220px; min-height:auto;}
.bar-wrap .bl{display:flex; justify-content:space-between; gap:6px; color:var(--parchment); margin-bottom:5px; text-transform:uppercase; letter-spacing:.04em; font-weight:600;}
.bar-wrap .bl span:first-child{min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
.bar-wrap .bl span:last-child{flex-shrink:0; font-family:var(--font-mono); color:var(--gold-bright); letter-spacing:0; text-transform:none; font-weight:700;}
.bar-line{display:flex; align-items:center; gap:6px;}
.bar-step{
  flex-shrink:0; width:20px; height:20px; line-height:1; border-radius:50%;
  background:var(--void-2); border:1px solid var(--leather-edge); color:var(--parchment-dim);
  font-size:.9rem; display:flex; align-items:center; justify-content:center; padding:0;
}
.bar-step:hover{color:var(--gold-bright); border-color:var(--gold-dim);}
.bar-step:active{transform:scale(.92);}
.bar-track{flex:1; height:12px; background:#0b0805; border-radius:6px; overflow:hidden; border:1px solid var(--leather-edge); cursor:pointer; position:relative;}
.bar-fill{height:100%; border-radius:6px; transition:width .5s cubic-bezier(.4,0,.2,1); position:relative;}
.bar-fill.hp{background:linear-gradient(90deg, #8f2a24, #ef5d4e); box-shadow:0 0 8px rgba(239,93,78,.5) inset;}
.bar-fill.temp{background:linear-gradient(90deg, #2f6fc4, #6fb3ff); box-shadow:0 0 8px rgba(111,179,255,.5) inset;}
.bar-fill.armor{background:linear-gradient(90deg, #7c8794, #c6d0db); box-shadow:0 0 8px rgba(198,208,219,.4) inset;}
.bar-fill.reaction{background:linear-gradient(90deg, var(--gold-dim), var(--gold-bright)); box-shadow:0 0 8px rgba(240,192,90,.5) inset;}
.bar-fill.hitdice{background:linear-gradient(90deg, #34572c, #86c26f); box-shadow:0 0 8px rgba(134,194,111,.45) inset;}
.bar-fill.pulse-down{animation:pulseDown .4s ease;}
.bar-fill.pulse-up{animation:pulseUp .4s ease;}
@keyframes pulseDown{0%{filter:brightness(2.2);}100%{filter:brightness(1);}}
@keyframes pulseUp{0%{filter:brightness(2.2) saturate(1.6);}100%{filter:brightness(1);}}

/* Spell-slot pips (manual, per level) */
.pip-row{display:flex; flex-wrap:wrap; gap:5px;}
.pip{
  width:18px; height:18px; border-radius:50%; flex-shrink:0; cursor:pointer;
  border:1.5px solid #b088ff; background:radial-gradient(circle at 35% 30%, #cbb2ff, #8a5cf0 70%);
  box-shadow:0 0 6px rgba(150,110,255,.55); transition:transform .12s ease, background .15s ease, opacity .15s ease;
}
.pip:hover{transform:scale(1.15);}
.pip.spent{background:#241c33; border-color:#4a3d63; box-shadow:none; opacity:.55;}
.pip-row-label{font-size:.68rem; color:var(--parchment-dim); text-transform:uppercase; letter-spacing:.05em; margin-bottom:4px; display:flex; justify-content:space-between;}
.pip-row-label span:last-child{color:var(--gold-bright); font-family:var(--font-mono); text-transform:none;}

/* --- Content --- */
#content{padding:18px 20px 90px; flex:1;}
.tab-panel{animation:fadeIn .22s ease;}
@keyframes fadeIn{from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:none;}}
.section-title{font-family:var(--font-display); color:var(--gold-bright); font-size:1.3rem; margin:0 0 4px; display:flex; align-items:center; gap:10px;}
.section-sub{color:var(--parchment-dim); font-size:.85rem; margin-bottom:16px;}

/* Attribute cards */
.attr-grid{display:grid; grid-template-columns:repeat(auto-fit, minmax(170px,1fr)); gap:14px;}
.attr-card{text-align:center; position:relative;}
.attr-card .aname{font-family:var(--font-display); letter-spacing:.1em; font-size:.85rem; color:var(--parchment-dim); text-transform:uppercase;}
.attr-card .amod{font-family:var(--font-mono); font-size:2.6rem; color:var(--gold-bright); line-height:1.1; margin:4px 0;}
.attr-card .atotal{font-size:.8rem; color:var(--parchment-dim); margin-bottom:8px;}
.attr-card .ainputs{display:grid; grid-template-columns:1fr 1fr 1fr; gap:6px; text-align:left;}
.attr-card input{width:100%; text-align:center;}
.roll-btn{width:100%; margin-top:8px;}

/* Skills / saves list */
.skill-row{display:flex; align-items:center; gap:8px; padding:6px 8px; border-radius:var(--radius-sm); border-bottom:1px solid rgba(255,255,255,.04);}
.skill-row:hover{background:rgba(200,153,46,.06);}
.skill-row .prof-dot{width:15px; height:15px; border-radius:50%; border:2px solid var(--steel); background:transparent; flex-shrink:0; cursor:pointer; box-shadow:0 0 0 1px rgba(0,0,0,.4);}
.skill-row .prof-dot.half{background:linear-gradient(90deg, var(--gold) 50%, transparent 50%);}
.skill-row .prof-dot.prof{background:var(--gold); border-color:var(--gold-bright);}
.skill-row .prof-dot.expertise{background:var(--gold); border-color:var(--gold-bright); box-shadow:0 0 0 2px var(--gold-bright);}
.skill-row .sname{flex:1; min-width:0;}
.skill-row .sattr{font-size:.68rem; color:var(--parchment-dim); text-transform:uppercase;}
.skill-row .smod{font-family:var(--font-mono); width:44px; text-align:center; font-size:1.05rem; color:var(--gold-bright);}
.skill-row .sbonus{width:52px;}

/* Esquiva hero */
.esquiva-hero{display:flex; align-items:center; gap:20px; justify-content:center; padding:14px 0;}
.esquiva-shield{
  width:130px; height:140px; position:relative; display:flex; align-items:center; justify-content:center; flex-direction:column;
  background:
    linear-gradient(160deg, var(--leather-2), var(--leather));
  clip-path:polygon(50% 0%, 100% 18%, 100% 62%, 50% 100%, 0% 62%, 0% 18%);
  border:3px solid var(--gold); box-shadow:0 6px 18px var(--shadow), inset 0 0 22px rgba(200,153,46,.15);
}
.esquiva-shield .num{font-family:var(--font-display); font-size:2.6rem; color:var(--gold-bright);}
.esquiva-shield .lbl{font-size:.68rem; letter-spacing:.15em; text-transform:uppercase; color:var(--parchment-dim);}
.esquiva-formula{font-family:var(--font-mono); font-size:.82rem; color:var(--parchment-dim); text-align:center; margin-top:6px;}

/* Cards grid (weapons/armor/inventory/spells) */
.item-grid{display:grid; grid-template-columns:repeat(auto-fill, minmax(280px,1fr)); gap:14px;}
.item-card{position:relative;}
.item-card.equipped-card{border-color:var(--gold); box-shadow:0 4px 14px var(--shadow), 0 0 0 1px var(--gold), inset 0 1px 0 rgba(255,255,255,.05);}
.equipped-badge{display:inline-block; font-size:.7rem; font-weight:700; color:#241a06; background:linear-gradient(180deg, var(--gold-bright), var(--gold)); padding:2px 9px; border-radius:999px;}
.item-card .ihead{display:flex; justify-content:space-between; align-items:flex-start; gap:8px; margin-bottom:6px; border-radius:6px;}
.item-card .ihead[data-collapse-toggle]{cursor:pointer; user-select:none; margin:-4px -4px 6px; padding:4px;}
.item-card .ihead[data-collapse-toggle]:hover{background:rgba(200,153,46,.08);}
.item-card .ihead .iname{display:flex; align-items:center; gap:6px;}
.item-card .ihead .chevron{font-size:.75rem; color:var(--parchment-dim); transition:transform .18s ease; flex-shrink:0;}
.item-card.collapsed .chevron{transform:rotate(-90deg);}
.item-card.collapsed .card-body{display:none;}
.item-card .collapsed-summary{display:none; font-size:.82rem; color:var(--parchment-dim); margin:-2px 0 2px;}
.item-card.collapsed .collapsed-summary{display:block;}
.item-card .iname{font-family:var(--font-display); color:var(--gold-bright); font-size:1.02rem;}
.item-card .itags{display:flex; flex-wrap:wrap; gap:4px; margin:6px 0;}
.item-card .actions{display:flex; gap:6px; flex-wrap:wrap; margin-top:10px;}
.armor-state-badge{font-size:.7rem; padding:2px 8px; border-radius:999px; font-weight:600;}
.armor-state-badge{font-weight:700; border:1px solid rgba(0,0,0,.35); box-shadow:0 1px 3px rgba(0,0,0,.4);}
.armor-state-badge.inteira{background:#3f7a35; color:#eafff0;}
.armor-state-badge.pouco{background:#8a9c3f; color:#1a1c08;}
.armor-state-badge.danificada{background:#c0932f; color:#211500;}
.armor-state-badge.muito{background:#b8362f; color:#fff2ef;}
.armor-state-badge.quebrada{background:#43403c; color:#e6e2da; text-decoration:line-through;}

/* Conditions/damage types */
.chip-grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); gap:10px;}
.chip{border:1px solid var(--leather-edge); border-radius:var(--radius-sm); padding:8px 10px; background:var(--void-2); display:flex; flex-direction:column; gap:4px;}
.chip select{width:100%;}
.state-normal{color:var(--parchment-dim);}
.state-resistencia{color:var(--forest-bright);}
.state-vulnerabilidade{color:var(--blood-bright);}
.state-imunidade{color:var(--arcane);}

/* History */
.hist-entry{border-left:3px solid var(--gold-dim); padding:6px 12px; margin-bottom:8px; background:var(--void-2); border-radius:0 var(--radius-sm) var(--radius-sm) 0; font-size:.88rem;}
.hist-entry .htime{font-family:var(--font-mono); font-size:.7rem; color:var(--parchment-dim);}

/* Dice roller floating */
#diceFab{
  position:fixed; right:22px; bottom:22px; z-index:60;
  width:66px; height:66px; border-radius:50%;
  background:radial-gradient(circle at 32% 28%, var(--gold-bright), var(--gold) 55%, var(--gold-dim) 100%);
  border:3px solid #6b4e18; box-shadow:0 8px 22px rgba(0,0,0,.5), inset 0 2px 4px rgba(255,255,255,.4);
  display:flex; align-items:center; justify-content:center; font-size:1.7rem; color:var(--ink);
  transition:transform .15s ease;
}
#diceFab:hover{transform:scale(1.06) rotate(-6deg);}
#diceTray{
  position:fixed; right:22px; bottom:100px; z-index:61; width:320px; max-width:90vw;
  background:linear-gradient(160deg, var(--parchment-2), var(--parchment)); color:var(--ink);
  border-radius:var(--radius); border:2px solid var(--gold-dim); box-shadow:0 14px 40px rgba(0,0,0,.6);
  padding:14px; transform-origin:bottom right; transform:scale(0); opacity:0; pointer-events:none; transition:transform .22s ease, opacity .18s ease;
  max-height:70vh; overflow-y:auto;
}
#diceTray.open{transform:scale(1); opacity:1; pointer-events:auto;}
#diceTray h4{margin:0 0 8px; font-family:var(--font-display); color:var(--ink-soft);}
#diceTray .quickdice{display:grid; grid-template-columns:repeat(4,1fr); gap:6px; margin-bottom:10px;}
#diceTray .quickdice button{background:var(--leather); color:var(--parchment); border:1px solid var(--leather-edge); border-radius:var(--radius-sm); padding:7px 0; font-family:var(--font-mono); font-size:.85rem;}
#diceTray .customroll{display:flex; gap:6px; margin-bottom:10px;}
#diceTray .customroll input{flex:1;}
#diceResult{font-family:var(--font-mono); background:var(--ink); color:var(--gold-bright); border-radius:var(--radius-sm); padding:10px; margin-bottom:8px; min-height:20px; font-size:.95rem;}
#diceHistoryMini{font-size:.78rem; color:var(--ink-soft); max-height:120px; overflow-y:auto;}
#diceHistoryMini div{border-bottom:1px dashed var(--gold-dim); padding:3px 0;}

/* Modal */
.modal-overlay{position:fixed; inset:0; background:rgba(10,7,3,.7); z-index:80; display:flex; align-items:center; justify-content:center; padding:16px;}
.modal{background:linear-gradient(160deg, var(--leather-2), var(--leather)); border:2px solid var(--gold-dim); border-radius:var(--radius); padding:20px; max-width:520px; width:100%; max-height:86vh; overflow-y:auto; box-shadow:0 20px 60px rgba(0,0,0,.6);}
.modal h3{font-family:var(--font-display); color:var(--gold-bright); margin-top:0;}
.modal .close-x{float:right; background:none; border:none; color:var(--parchment-dim); font-size:1.3rem;}

/* Roll popup toast */
#rollToastWrap{position:fixed; top:14px; left:50%; transform:translateX(-50%); z-index:90; display:flex; flex-direction:column; gap:8px; align-items:center;}
.roll-toast{
  background:linear-gradient(160deg, var(--parchment-2), var(--parchment)); color:var(--ink);
  border:2px solid var(--gold); border-radius:var(--radius); padding:10px 18px; box-shadow:0 10px 26px rgba(0,0,0,.55);
  font-family:var(--font-mono); font-size:.9rem; text-align:center; min-width:220px; animation:scrollUnfurl .35s ease;
}
.roll-toast .title{font-family:var(--font-display); font-size:.8rem; color:var(--ink-soft); letter-spacing:.05em; text-transform:uppercase;}
