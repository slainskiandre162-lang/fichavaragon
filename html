function markDirty(){
  const el = document.getElementById('saveIndicator');
  el.classList.add('saving');
  document.getElementById('saveText').textContent = 'Salvando...';
  clearTimeout(saveTimer);
  saveTimer = setTimeout(()=>{
    Store.save(CURRENT);
    el.classList.remove('saving');
    document.getElementById('saveText').textContent = 'Salvo';
  }, 350);
}

function toast(title, big, sub){
  const wrap = document.getElementById('rollToastWrap');
  const el = document.createElement('div');
  el.className = 'roll-toast';
  el.innerHTML = `<div class="title">${title}</div><div class="big">${big}</div>${sub?`<div class="muted">${sub}</div>`:''}`;
  wrap.appendChild(el);
  setTimeout(()=>{ el.style.opacity='0'; el.style.transition='opacity .4s'; setTimeout(()=>el.remove(),400); }, 3200);
}

