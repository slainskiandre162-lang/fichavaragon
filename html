      ${c.armors.map(a=>`<tr><td>${a.name}</td><td>${a.slot||''}</td><td>${a.rd||0}</td><td>${a.dodgeBonus||0}</td><td>${a.hpCurrent}/${a.hpMax}</td><td>${a.equipped?'Sim':'Não'}</td></tr>`).join('')||'<tr><td colspan=6>—</td></tr>'}
    </table></div>

    <div class="p-section"><h2>Perícias</h2><table>${Model.SKILLS.map(([n])=>`<tr><td>${n}</td><td>${Calc.fmt(Calc.skillMod(c,n))}</td></tr>`).join('')}</table></div>

    <div class="p-section"><h2>Testes de Resistência</h2><table><tr>${Object.keys(ATTR_NAMES).map(k=>`<th>${ATTR_NAMES[k]}</th>`).join('')}</tr>
    <tr>${Object.keys(ATTR_NAMES).map(k=>`<td>${Calc.fmt(Calc.saveMod(c,k))}</td>`).join('')}</tr></table></div>

    <div class="p-section"><h2>Inventário</h2><table><tr><th>Item</th><th>Qtd</th><th>Peso</th><th>Categoria</th></tr>
      ${c.inventory.map(i=>`<tr><td>${i.name}</td><td>${i.qty}</td><td>${i.weight}</td><td>${i.category}</td></tr>`).join('')||'<tr><td colspan=4>—</td></tr>'}
    </table></div>

    <div class="p-section"><h2>Magias</h2><table><tr><th>Nome</th><th>Nível</th><th>CD</th><th>Descrição</th></tr>
      ${c.spells.list.map(s=>`<tr><td>${s.name}</td><td>${s.level}</td><td>${s.dc}</td><td>${(s.description||'').slice(0,120)}</td></tr>`).join('')||'<tr><td colspan=4>—</td></tr>'}
    </table></div>

    <div class="p-section"><h2>Habilidades de Raça</h2><table><tr><th>Nome</th><th>Origem</th><th>Descrição</th></tr>
      ${c.raceFeatures.map(f=>`<tr><td>${f.name}</td><td>${f.level||''}</td><td>${(f.description||'').slice(0,160)}</td></tr>`).join('')||'<tr><td colspan=3>—</td></tr>'}
    </table></div>

    <div class="p-section"><h2>Habilidades de Classe</h2><table><tr><th>Nome</th><th>Nível</th><th>Descrição</th></tr>
      ${c.classFeatures.map(f=>`<tr><td>${f.name}</td><td>${f.level||''}</td><td>${(f.description||'').slice(0,160)}</td></tr>`).join('')||'<tr><td colspan=3>—</td></tr>'}
    </table></div>

    <div class="p-section"><h2>Condições Ativas</h2><p>${c.conditions.map(x=>x.name).join(', ')||'Nenhuma'}</p></div>
    <div class="p-section"><h2>Anotações</h2><p>${(c.notes||'').replace(/\n/g,'<br>')}</p></div>
    `;
    return html;
  }
  function exportPdf(){
    document.getElementById('printSheet').innerHTML = build(CURRENT);
    window.print();
  }
  return {exportPdf};
})();

/* ---------------------- APP (init + character mgmt + dice tray) ---------------------- */
const App = (() => {
  function ensureCharacter(){
    let id = Store.getActiveId();
    let c = id ? Store.load(id) : null;
    if(!c){
      c = Model.blankCharacter('Novo Aventureiro');
      Store.save(c);
      Store.setActiveId(c.id);
    }
    CURRENT = c;
  }

  function newCharacter(name){
    const c = Model.blankCharacter(name||'Novo Aventureiro');
    Store.save(c);
    Store.setActiveId(c.id);
    CURRENT = c;
    UI.render();
    closeModal();
  }
  function switchTo(id){
    const c = Store.load(id);
    if(c){ CURRENT=c; Store.setActiveId(id); UI.render(); closeModal(); }
  }
  function duplicateCurrent(){
    const copy = JSON.parse(JSON.stringify(CURRENT));
    copy.id = Model.uid('char');
    copy.meta.name = copy.meta.name + ' (Cópia)';
    Store.save(copy);
    Store.setActiveId(copy.id);
    CURRENT = copy;
    UI.render();
    closeModal();
  }

  /* Núcleo compartilhado de exclusão: remove o personagem do armazenamento e,
     caso seja o personagem ativo, seleciona outro (ou cria um novo em branco). */
  function deleteCharacterCore(id){
    const wasActive = (CURRENT && CURRENT.id === id);
    Store.remove(id);
    if(wasActive){
      const remaining = Store.listIds();
      if(remaining.length>0){
        const c = Store.load(remaining[0]);
        CURRENT = c;
        Store.setActiveId(c.id);
      } else {
        const c = Model.blankCharacter('Novo Aventureiro');
        Store.save(c);
        Store.setActiveId(c.id);
        CURRENT = c;
      }
      UI.render();
    }
  }

  // Exclui um personagem específico a partir do Gerenciador de Personagens (lista completa)
  function deleteCharacter(id){
    const summary = Store.allCharsSummary().find(ch=>ch.id===id);
    const name = summary ? summary.name : 'este personagem';
    if(!confirm(`Excluir "${name}" permanentemente? Essa ação não pode ser desfeita.`)) return;
    deleteCharacterCore(id);
    openCharManager(); // atualiza a lista exibida no modal
  }

  // Exclui o personagem atualmente ativo (usado no botão da aba Configurações)
  function deleteCurrent(){
    if(!confirm('Excluir permanentemente este personagem? Essa ação não pode ser desfeita.')) return;
    deleteCharacterCore(CURRENT.id);
    closeModal();
  }

  function openCharManager(){
    const chars = Store.allCharsSummary();
    const html = `<button class="close-x" onclick="closeModal()">✕</button>
      <h3>Personagens</h3>
      <div id="charListWrap">${chars.map(ch=>`
        <div class="char-list-item ${ch.id===CURRENT.id?'active':''}">
          <div class="cname">${ch.name} <span class="muted">(Nv.${ch.level} ${ch.cls})</span></div>
          <button class="btn small" onclick="App.switchTo('${ch.id}')">Selecionar</button>
          <button class="btn small danger" onclick="App.deleteCharacter('${ch.id}')">🗑️</button>
        </div>`).join('') || '<p class="muted">Nenhum personagem salvo ainda.</p>'}</div>
      <div class="row" style="margin-top:14px;">
        <button class="btn" onclick="App.promptNewCharacter()">+ Criar Novo</button>
        <button class="btn secondary" onclick="App.duplicateCurrent()">⧉ Duplicar Atual</button>
      </div>`;
    openModal(html);
  }
  function promptNewCharacter(){
    const name = prompt('Nome do novo personagem:', 'Novo Aventureiro');
    if(name===null) return;
    newCharacter(name);
  }

  function exportJson(){
    const blob = new Blob([JSON.stringify(CURRENT,null,2)], {type:'application/json'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = `${(CURRENT.meta.name||'personagem').replace(/\s+/g,'_')}.json`;
    document.body.appendChild(a); a.click(); a.remove();
    URL.revokeObjectURL(url);
  }
  function importJson(file){
    const reader = new FileReader();
    reader.onload = (e)=>{
      try{
        let data = JSON.parse(e.target.result);
        if(!data.id) data.id = Model.uid('char');
        data = Model.normalize(data);
        Store.save(data);
        Store.setActiveId(data.id);
        CURRENT = data;
        UI.render();
        toast('Importado', '✓', CURRENT.meta.name||'Personagem importado');
      }catch(err){
        alert('Arquivo inválido. Certifique-se de importar um JSON exportado por esta ficha.');
      }
    };
    reader.readAsText(file);
  }

  function initDiceTray(){
    const fab = document.getElementById('diceFab');
    const tray = document.getElementById('diceTray');
    fab.addEventListener('click', ()=> tray.classList.toggle('open'));
    document.addEventListener('click', (e)=>{
      if(!tray.contains(e.target) && e.target!==fab && tray.classList.contains('open') && !fab.contains(e.target)){
        // keep open only if clicking fully outside both
      }
    });
    function doRoll(expr){
      const r = Dice.parseAndRoll(expr);
      if(!r){ document.getElementById('diceResult').textContent = 'Expressão inválida.'; return; }
      document.getElementById('diceResult').innerHTML = `<b>${r.total}</b><br><span style="font-size:.78rem;">${r.detail}</span>`;
      const mini = document.getElementById('diceHistoryMini');
      const line = document.createElement('div');
      line.textContent = `${expr} = ${r.total}`;
      mini.prepend(line);
      Hist.add(CURRENT, 'Rolagem de Dados', `${expr} = ${r.total}`, r.detail);
      markDirty();
    }
    tray.querySelectorAll('[data-die]').forEach(btn=>{
      btn.addEventListener('click', ()=>{
        const d = btn.dataset.die;
        if(d==='20adv') doRoll('2d20kh1');
        else doRoll('1d'+d);
      });
    });
    document.getElementById('btnRollCustom').addEventListener('click', ()=>{
      const expr = document.getElementById('customDiceExpr').value.trim();
      if(expr) doRoll(expr);
    });
    document.getElementById('customDiceExpr').addEventListener('keydown', (e)=>{
      if(e.key==='Enter'){ document.getElementById('btnRollCustom').click(); }
    });
  }

  function initTopbarButtons(){
    document.getElementById('btnSwitchChar').addEventListener('click', openCharManager);
    document.getElementById('btnExportJson').addEventListener('click', exportJson);
    document.getElementById('btnImportJson').addEventListener('click', ()=>document.getElementById('importFileInput').click());
    document.getElementById('importFileInput').addEventListener('change', (e)=>{
      if(e.target.files[0]) importJson(e.target.files[0]);
      e.target.value = '';
    });
    document.getElementById('btnExportPdf').addEventListener('click', ()=>PDF.exportPdf());
    document.getElementById('btnGotoConfig').addEventListener('click', ()=>UI.setTab('config'));
  }

  function init(){
    ensureCharacter();
    initTopbarButtons();
    initDiceTray();
    UI.render();
  }

  return {init, newCharacter, switchTo, duplicateCurrent, deleteCurrent, deleteCharacter, openCharManager, promptNewCharacter, exportJson, importJson};
})();

document.addEventListener('DOMContentLoaded', App.init);
</script>
</body>
</html>
