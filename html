      markDirty();
    });
    div.querySelector('[data-act="damage"]').addEventListener('click', ()=>{
      const attrMod = Calc.weaponAttrMod(CURRENT, w);
      const expr = `${w.damageDice||'1d6'}+${attrMod+(w.magicBonus||0)+(w.tempBonus||0)}`;
      const r = Dice.parseAndRoll(expr);
      toast(`Dano: ${w.name}`, r.total, `${w.damageDice} ${Calc.fmt(attrMod)} mágico${Calc.fmt(w.magicBonus||0)}`);
      Hist.add(CURRENT,'Dano causado', `${w.name}: ${r.total}`, r.detail);
      markDirty();
    });
    div.querySelector('[data-act="crit"]').addEventListener('click', ()=>{
      const attrMod = Calc.weaponAttrMod(CURRENT, w);
      const diceMatch = (w.damageDice||'1d6').match(/(\d*)d(\d+)/i);
      const count = diceMatch && diceMatch[1] ? parseInt(diceMatch[1]) : 1;
      const sides = diceMatch ? parseInt(diceMatch[2]) : 6;
      const critExpr = `${count*2}d${sides}+${attrMod+(w.magicBonus||0)+(w.tempBonus||0)}`;
      const r = Dice.parseAndRoll(critExpr);
      toast(`CRÍTICO: ${w.name}`, r.total, `Dados dobrados (${critExpr})`);
      Hist.add(CURRENT,'Dano Crítico', `${w.name}: ${r.total}`, r.detail);
      markDirty();
    });
    div.querySelector('[data-act="dup"]').addEventListener('click', ()=>{
      CURRENT.weapons.push(JSON.parse(JSON.stringify({...w, id:Model.uid('wpn'), equipped:false})));
      markDirty(); render();
    });
    div.querySelector('[data-act="del"]').addEventListener('click', ()=>{
      CURRENT.weapons = CURRENT.weapons.filter(x=>x.id!==w.id);
      markDirty(); render();
    });
    return div;
  }
